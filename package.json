{
  "name": "lazydm",
  "version": "0.1.0",
  "description": "LazyDM - Your lazy dungeon master assistant",
  "author": "Tratt0re",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/lazy_dm.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:web": "node scripts/build-web.js",
    "build:preload": "node scripts/build-preload.js",
    "build:preload:prod": "node scripts/build-preload.js --prod",
    "build:prod": "npm run build:web && npm run build:preload:prod",
    "preload:watch": "node scripts/build-preload.js --watch",
    "icons:mac": "bash scripts/make-mac-icon.sh",
    "build:desktop": "npm run build:prod && electron-builder --dir --publish never",
    "dist": "npm run build:prod && electron-builder --publish never",
    "dist:mac": "npm run build:prod && electron-builder --mac --publish never",
    "dist:mac-intel": "npm run build:prod && electron-builder --mac --x64 --publish never",
    "dist:all": "node scripts/build-all.js",
    "dist:win": "npm run build:prod && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build:prod && electron-builder --linux --publish never",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:electron": "vitest run --config vitest.electron.config.mjs",
    "electron:dev": "npm run build:preload && electronmon .",
    "electron:start": "npm run build:preload && electron .",
    "electron:prod": "npm run build:prod && electron . --prod",
    "dev": "concurrently -k \"ng serve\" \"npm run preload:watch\" \"wait-on http://localhost:4200 && npm run electron:dev\"",
    "test:electron:index": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --config vitest.electron.config.mjs electron/__tests__/link-resolution.test.js electron/__tests__/sync-copies-flow.test.js",
    "bench:index": "ELECTRON_RUN_AS_NODE=1 electron scripts/bench-index.js"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://lazydm.com",
  "packageManager": "npm@11.8.0",
  "build": {
    "appId": "com.lazydm.desktop",
    "productName": "LazyDM",
    "directories": {
      "output": "release",
      "buildResources": "."
    },
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "dist/lazydm/browser/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "icon": "src/assets/icon/lazydm_ico_win.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "lazydm-setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "lazydm-portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "src/assets/icon/lazydm_ico_win.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "@angular/cdk": "^21.1.4",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "echarts": "^6.0.0",
    "embla-carousel-angular": "^21.0.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-class-names": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "leaflet": "^1.9.4",
    "lucide-angular": "^0.563.0",
    "markdown-it": "^15.0.2",
    "ngx-echarts": "^21.0.0",
    "ngx-sonner": "^3.1.0",
    "rxjs": "~7.8.0",
    "semver": "^7.7.4",
    "tailwind-merge": "^3.4.0",
    "tslib": "^2.3.0",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.2.25",
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/leaflet": "^1.9.21",
    "@types/semver": "^7.7.1",
    "concurrently": "^9.2.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.7.0",
    "electronmon": "^2.0.4",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.3"
  }
}
